{
  "manifest_version": 3,
  "name": "CyberGuard Sentinel — Protection Active",
  "version": "1.0",
  "description": "Protection active en arrière-plan : Intercepte et évalue en temps réel (<20ms) chaque URL ouverte dans Google Chrome avec IA CyberGuard.",
  "permissions": [
    "tabs",
    "notifications",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*",
    "http://localhost:3000/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "CyberGuard Sentinel",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
