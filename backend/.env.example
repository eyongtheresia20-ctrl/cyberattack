# ==========================================
# PhishGuard Security Platform Environment Config
# ==========================================

# Database Configuration (PostgreSQL / pgAdmin)
# Set USE_SQLITE_FALLBACK=False to connect directly to PostgreSQL
USE_SQLITE_FALLBACK=False
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=phishguard

# Explicit Database Connection URL (Optional - constructed automatically if empty)
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/phishguard

# External Security Intelligence APIs
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# AI Assistant API Keys (Optional - falls back to built-in knowledge base if empty)
OPENAI_API_KEY=
GEMINI_API_KEY=
